# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored — it will never be committed.
# Requires `pip install python-dotenv` for these to be auto-loaded by app.py
# (optional — you can also just set these as real environment variables).

# --- Database connection ---
DASHBOARD_DB_SERVER=172.16.1.13
DASHBOARD_DB_NAME=Ops_Analytics
DASHBOARD_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Security ---
# Flask session signing key. Set this to a long random string in production
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# If unset, a random key is generated at each process start, which logs
# everyone out whenever the app restarts.
DASHBOARD_SECRET_KEY=

# Passcode for the offline / cached-only login (NOT a SQL login).
# Change this from the default before sharing the app with anyone.
DASHBOARD_OFFLINE_PASSCODE=view-only

# --- Behaviour ---
# Seconds a live query result is reused before re-querying the DB.
DASHBOARD_CACHE_TTL_SECONDS=120
